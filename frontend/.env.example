# Vite forwards /api to Java in local development. Never put database credentials here.
API_PROXY_TARGET=http://127.0.0.1:8080
# Production: Java HTTPS origin without a trailing /api, or empty for same-origin proxy.
VITE_API_BASE_URL=
# Production only: enable real login/registration when the API is reachable.
# Local npm run dev enables both automatically.
VITE_API_ENABLED=false
